<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>1.3.1</VersionPrefix>
    <VersionSuffix>rc1</VersionSuffix>
    <ApplicationIcon>Resources\power_surge.ico</ApplicationIcon>
    <Description>Tray-Icon tool to show the currently selected windows power plan, switch it manually and automatically.

PowerPlanSwitcher is using the following tools, resources and libraries:

- [.NET 10](https://learn.microsoft.com/en-us/dotnet/core/whats-new/dotnet-10)
- [Newtonsoft.Json](https://www.newtonsoft.com/json)
- The amazing [FatCow IconPack](https://www.fatcow.com/free-icons)
- [WindowsAPICodePack](https://github.com/contre/Windows-API-Code-Pack-1.1)
- [Vanara](https://github.com/dahall/Vanara)
- [Serilog](https://serilog.net/)
- [SevenZipSharp](https://github.com/squid-box/SevenZipSharp)
- [WiX Toolset 6](https://wixtoolset.org/)
- [HotkeyManager](https://github.com/SebastianBecker2/HotkeyManager)
- [DotNet.Glob](https://github.com/dazinator/DotNet.Glob)
- [AutoFac](https://autofac.org/)
- [System.CommandLine](https://learn.microsoft.com/en-us/dotnet/standard/commandline/)</Description>
    <Authors>Sebastian Becker</Authors>
    <Company>Sebastian Becker</Company>
    <Product>PowerPlanSwitcher</Product>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <NeutralLanguage>en</NeutralLanguage>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Resources\power_surge.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.0.0" />
    <PackageReference Include="HotkeyManager" Version="1.0.1" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
    <PackageReference Include="Vanara.PInvoke.PowrProf" Version="4.2.1" />
    <PackageReference Include="Vanara.PInvoke.Security" Version="4.2.1" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="4.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerManagement\PowerManagement.csproj" />
    <ProjectReference Include="..\ProcessManagement\ProcessManagement.csproj" />
    <ProjectReference Include="..\RuleManagement\RuleManagement.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Translations\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="Resources\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\7z_license.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\fatcow-hosting-icons-3.9.2.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    把 Build 生成的卫星程序集从 <culture>\ 移到 Lang\<culture>\。
    只移动本解决方案自己项目的卫星程序集，第三方的（例如 Vanara 的 fr）
    保持原样。新增自己项目时，把该项目名加进 _OwnSatelliteNames 列表。
    Move satellite assemblies produced by Build from <culture>\ to
    Lang\<culture>\. Only own-project satellite assemblies are moved;
    third-party ones (e.g. Vanara's fr) stay in place. When adding a new own
    project with localized strings, add its name to _OwnSatelliteNames.
  -->
  <Target Name="MoveSatelliteAssembliesToLang" AfterTargets="Build">
    <ItemGroup>
      <_OwnSatelliteNames Include="PowerPlanSwitcher.resources.dll" />
      <_OwnSatelliteNames Include="RuleManagement.resources.dll" />
      <_OwnSatelliteNames Include="PowerManagement.resources.dll" />
      <_OwnSatelliteNames Include="ProcessManagement.resources.dll" />
      <_OwnSatelliteNames Include="SystemManagement.resources.dll" />
      <_OwnSatelliteNames Include="WindowMessageTimer.resources.dll" />
    </ItemGroup>
    <ItemGroup>
      <_SatelliteDlls Include="$(TargetDir)*\%(_OwnSatelliteNames.Identity)" />
    </ItemGroup>
    <Move SourceFiles="@(_SatelliteDlls)"
          DestinationFolder="$(TargetDir)Lang\%(_SatelliteDlls.RecursiveDir)"
          Condition="'@(_SatelliteDlls)' != ''" />
    <RemoveDir Directories="@(_SatelliteDlls->'%(RootDir)%(Directory)')"
               Condition="'@(_SatelliteDlls)' != ''" />
  </Target>

  <!--
    Publish 输出同样处理。
    Same for Publish output.
  -->
  <Target Name="MoveSatelliteAssembliesToLangPublish" AfterTargets="Publish">
    <ItemGroup>
      <_OwnSatelliteNames Include="PowerPlanSwitcher.resources.dll" />
      <_OwnSatelliteNames Include="RuleManagement.resources.dll" />
      <_OwnSatelliteNames Include="PowerManagement.resources.dll" />
      <_OwnSatelliteNames Include="ProcessManagement.resources.dll" />
      <_OwnSatelliteNames Include="SystemManagement.resources.dll" />
      <_OwnSatelliteNames Include="WindowMessageTimer.resources.dll" />
    </ItemGroup>
    <ItemGroup>
      <_PublishedSatelliteDlls Include="$(PublishDir)*\%(_OwnSatelliteNames.Identity)" />
    </ItemGroup>
    <Move SourceFiles="@(_PublishedSatelliteDlls)"
          DestinationFolder="$(PublishDir)Lang\%(_PublishedSatelliteDlls.RecursiveDir)"
          Condition="'@(_PublishedSatelliteDlls)' != ''" />
    <RemoveDir Directories="@(_PublishedSatelliteDlls->'%(RootDir)%(Directory)')"
               Condition="'@(_PublishedSatelliteDlls)' != ''" />
  </Target>
</Project>